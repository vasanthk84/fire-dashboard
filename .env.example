# Copy this file to .env and fill in the values you actually use.
# .env is gitignored — never commit real credentials.

# --- Optional cloud backup (api/state.js) ---
# Free Upstash Redis database. Two ways to get these two values:
#
#   1. Reuse the same free Upstash database D:\ReactApp\ledger-app already
#      runs on (its server/services/storage.kv.js uses the exact same
#      UPSTASH_REDIS_REST_URL/TOKEN pair). Safe to share: it's plain
#      key-value storage with no schema, and fire-dashboard's data lives
#      entirely under its own "fire-dashboard:" key prefix, with zero
#      overlap with ledger-app's "config:"/"txn:"/"u:{userId}:" keys. Both
#      apps then share the same free-tier quota (500K commands/month,
#      256MB) — fine for two personal apps, but worth knowing. Copy the two
#      values straight from ledger-app's own .env file.
#   2. Or provision a separate one: via the Vercel Marketplace
#      (`vercel install upstash`, or Vercel dashboard → Storage → Add →
#      Upstash) or directly at https://upstash.com (free tier, no card
#      required — adding a card switches the account to pay-as-you-go).
#
# On Vercel, installing the integration injects these automatically; either
# way you only need to set them here for local dev. Leave both unset and the
# app works exactly as before (localStorage-only) — the "Cloud sync" card in
# the Snapshots tab just shows "not configured".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional: pin a specific Python interpreter for local CAS import ---
# Only needed if server.js's automatic py/python/python3 detection picks the
# wrong one. Full path to a real python.exe (not the Microsoft Store stub).
# CAS_PYTHON_BIN=

# --- Optional: actual options yield, read from trade-analytics (api/trading-income.js) ---
# zerodha-report is the "p&l determination engine" — the single source of
# truth for realized trading P&L. Setting these lets the "Options income"
# card show actual realized yield next to the optionsYieldPct you type in.
#   TA_API_TOKEN        — must match the token set on the zerodha-report
#                          Vercel project (see Zerodha_Reports/lib/auth.js)
#   TRADE_ANALYTICS_URL — optional override; defaults to the production
#                          trade-analytics deployment
# Leave TA_API_TOKEN unset and the hint just doesn't render — nothing breaks.
TA_API_TOKEN=
TRADE_ANALYTICS_URL=https://zerodha-report.vercel.app

# --- Optional: actual options capital deployed, read from oi-analyzer (api/options-capital.js) ---
# Setting these lets the "Options income" card show the actual capital
# currently deployed in open wheel cycles next to optionsPortfolioValue.
#   OI_ANALYZER_TOKEN — must match FIRE_DASHBOARD_TOKEN set on oi-analyzer
#                        (see backend/api/routes/wheel_journal.py's
#                        _check_fire_dashboard_token)
#   OI_ANALYZER_URL   — optional override; defaults to the production
#                        droplet below
# NOTE: oi-analyzer's backend is plain HTTP (no TLS) at that address today —
# this token travels unencrypted, same accepted exposure SITE_PASSWORD and
# ADMIN_SECRET already have on that link. Leave OI_ANALYZER_TOKEN unset and
# the hint just doesn't render — nothing breaks.
OI_ANALYZER_TOKEN=
OI_ANALYZER_URL=http://165.227.84.87:82
